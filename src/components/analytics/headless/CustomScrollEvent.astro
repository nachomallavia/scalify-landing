---
/**
 * CustomScrollEvent Component
 * Tracks scroll depth milestones: 25%, 50%, 75%, 100%
 * 
 * Usage:
 * <CustomScrollEvent 
 *   eventName="section_scroll_percent" 
 *   scrollSectionName="Hero"
 * >
 *   <YourSection />
 * </CustomScrollEvent>
 */

import { generateContextId, mergeEventData } from '@/lib/analytics/utils';

interface Props {
  eventName: string;
  eventData?: Record<string, any>;
  milestones?: number[];
  scrollSectionName?: string;  // Identifies which section is being scrolled
  [key: string]: any;
}

const { 
  eventName, 
  eventData = {},
  milestones = [25, 50, 75, 100],
  ...additionalProps 
} = Astro.props;

// Generate unique ID for this tracker
const trackerId = generateContextId();

// Check if in testing mode
const isTestingMode = import.meta.env.PUBLIC_LIVE_TESTING === 'true';

// Merge all data (includes [TEST] prefix and environment field when in testing mode)
const finalEventData = mergeEventData(eventName, eventData, additionalProps, isTestingMode);
---

<span 
  style="display:contents" 
  data-analytics-scroll
  data-scroll-event={eventName}
  data-scroll-data={JSON.stringify(finalEventData)}
  data-scroll-milestones={JSON.stringify(milestones)}
  data-tracker-id={trackerId}
>
  <slot />
</span>

<script>
  /**
   * HYBRID SCROLL TRACKING: IntersectionObserver + Scroll Listener
   * 
   * APPROACH:
   * 1. IntersectionObserver detects when element is visible (prevents premature events)
   * 2. Scroll listener calculates actual scroll progress (only when visible)
   * 3. Scroll listener is attached/detached based on visibility (performance)
   * 
   * BENEFITS:
   * - No premature events before DOMContentLoaded
   * - Accurate scroll depth calculation
   * - Better performance (scroll listener only active when needed)
   * - Framework-agnostic (standard web APIs)
   */
  
  const globalFlag = '__analyticsScrollObserverAttached';
  const trackedMilestones = new Map<Element, Set<number>>();
  const visibleElements = new Set<Element>();
  let scrollHandler: (() => void) | null = null;

  function trackMilestone(
    wrapper: Element,
    milestone: number,
    scrollPercent: number
  ) {
    const eventName = wrapper.getAttribute('data-scroll-event');
    const eventDataStr = wrapper.getAttribute('data-scroll-data');
    
    if (!eventName || !eventDataStr) return;
    
    try {
      const eventData = JSON.parse(eventDataStr);
      eventData.scrollDepth = milestone;
      eventData.scrollPercent = Math.round(scrollPercent);
      
      // Push to dataLayer
      if (window.dataLayer) {
        window.dataLayer.push(eventData);
      }
      
      // Push to PostHog
      if (window.posthog) {
        const { event, ...properties } = eventData;
        window.posthog.capture(event, properties);
      }
      
      // Debug logging
      if (import.meta.env.PUBLIC_ANALYTICS_DEBUG === 'true') {
        console.log('[CustomScrollEvent] Milestone tracked:', eventData);
      }
    } catch (error) {
      console.error('[CustomScrollEvent] Error parsing event data:', error);
    }
  }

  function calculateScrollProgress(wrapper: Element): number {
    const childElement = wrapper.firstElementChild as HTMLElement;
    if (!childElement) return 0;
    
    const rect = childElement.getBoundingClientRect();
    const elementHeight = rect.height;
    const windowHeight = window.innerHeight;
    
    // Element not yet in viewport
    if (rect.bottom < 0) return 100; // Scrolled past
    if (rect.top > windowHeight) return 0; // Not yet reached
    
    // Calculate scroll progress
    // scrollProgress = how far from top of viewport to top of element
    // When element.top = windowHeight, progress = 0%
    // When element.bottom = 0, progress = 100%
    const scrollProgress = Math.max(0, windowHeight - rect.top);
    const maxProgress = elementHeight + windowHeight;
    
    return Math.min((scrollProgress / maxProgress) * 100, 100);
  }

  function checkMilestones(wrapper: Element) {
    const scrollPercent = calculateScrollProgress(wrapper);
    
    // Get milestones for this element
    const milestonesStr = wrapper.getAttribute('data-scroll-milestones');
    const milestones: number[] = milestonesStr ? JSON.parse(milestonesStr) : [25, 50, 75, 100];
    
    // Initialize tracked set
    if (!trackedMilestones.has(wrapper)) {
      trackedMilestones.set(wrapper, new Set());
    }
    
    const tracked = trackedMilestones.get(wrapper)!;
    const sortedMilestones = [...milestones].sort((a, b) => a - b);
    
    // Track milestones in order
    for (const milestone of sortedMilestones) {
      if (scrollPercent >= milestone && !tracked.has(milestone)) {
        // Check if all previous milestones were tracked
        const previousMilestones = sortedMilestones.filter(m => m < milestone);
        const allPreviousTracked = previousMilestones.every(m => tracked.has(m));
        
        if (allPreviousTracked || previousMilestones.length === 0) {
          trackMilestone(wrapper, milestone, scrollPercent);
          tracked.add(milestone);
          break; // One per scroll event
        }
      }
    }
  }

  function handleScroll() {
    // Only check visible elements (tracked by IntersectionObserver)
    visibleElements.forEach(wrapper => {
      checkMilestones(wrapper);
    });
  }

  function initScrollTracking() {
    if ((window as any)[globalFlag]) return;
    
    const wrappers = document.querySelectorAll('[data-analytics-scroll]');
    
    // Create IntersectionObserver to detect visibility
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          const wrapper = entry.target.parentElement;
          if (!wrapper || !wrapper.hasAttribute('data-analytics-scroll')) return;
          
          if (entry.isIntersecting) {
            // Element became visible - add to tracking set
            visibleElements.add(wrapper);
            
            // Check immediately in case already at a milestone
            checkMilestones(wrapper);
          } else {
            // Element left viewport - remove from tracking set
            visibleElements.delete(wrapper);
          }
        });
      },
      {
        threshold: [0], // Just detect when element enters/exits viewport
        rootMargin: '0px'
      }
    );
    
    // Observe all child elements
    wrappers.forEach(wrapper => {
      const childElement = wrapper.firstElementChild;
      if (childElement) {
        observer.observe(childElement);
      }
    });
    
    // Attach global scroll listener (only processes visible elements)
    scrollHandler = () => handleScroll();
    window.addEventListener('scroll', scrollHandler, { passive: true });
    
    (window as any)[globalFlag] = true;
    
    if (import.meta.env.PUBLIC_ANALYTICS_DEBUG === 'true') {
      console.log('[CustomScrollEvent] Hybrid tracking initialized for', wrappers.length, 'elements');
    }
  }

  // Initialize AFTER DOMContentLoaded to ensure all content is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollTracking);
  } else {
    // DOM already loaded, but use setTimeout to ensure React components are hydrated
    setTimeout(initScrollTracking, 100);
  }
</script>
