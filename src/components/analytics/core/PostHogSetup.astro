---
/**
 * PostHogSetup COMPONENT
 * 
 * PURPOSE: Initialize PostHog with privacy-first configuration
 * PATTERN: SSR component that injects PostHog loader snippet
 * DEPENDENCIES: PUBLIC_POSTHOG_KEY env variable, window.posthog
 * OUTPUT: Loads PostHog SDK, captures pageview, enables session replay
 * 
 * POSTHOG vs GTM:
 * - GTM: Tag container, manages many tools, event queueing
 * - PostHog: Product analytics + session replay + feature flags
 * 
 * PRIVACY-FIRST CONFIG:
 * - person_profiles: 'identified_only' → Only track after identifyUser()
 * - maskAllInputs: true → Never record form input content
 * - maskTextSelector: '[data-private]' → Hide sensitive elements
 * 
 * SESSION REPLAY:
 * Unlike GTM, PostHog can record user sessions (mouse movements,
 * clicks, scrolls) for debugging and UX analysis.
 * 
 * IMPORTANT: Only works after identifyUser() is called!
 * This prevents tracking anonymous sessions (privacy compliance).
 * 
 * PROPS vs ENV:
 * - posthogKey prop: When passed by AnalyticsSetup (testing/production resolution)
 * - PUBLIC_POSTHOG_KEY env: Fallback when used standalone without AnalyticsSetup
 */

// ============================================================================
// PROPS & CONFIGURATION
// ============================================================================

interface Props {
  posthogKey?: string;      // Effective PostHog key (from AnalyticsSetup when testing mode)
  isTestingMode?: boolean;  // Flag for [TEST] prefix and environment field
  pageCategory?: string;
  pageType?: string;
  additionalData?: Record<string, any>;
}

const { posthogKey: posthogKeyProp, isTestingMode = false, pageCategory, pageType, additionalData = {} } = Astro.props;

// ============================================================================
// ENVIRONMENT DETECTION
// ============================================================================

const POSTHOG_KEY_ENV = import.meta.env.PUBLIC_POSTHOG_KEY;
const IS_DEBUG = import.meta.env.PUBLIC_ANALYTICS_DEBUG === 'true';
const IS_PROD = import.meta.env.PROD;

// Resolve PostHog key: prop takes precedence (from AnalyticsSetup), else env
const POSTHOG_KEY = posthogKeyProp || POSTHOG_KEY_ENV;

// Only load when key is configured AND (production OR debug mode)
const shouldLoadPostHog = Boolean(POSTHOG_KEY) && (IS_PROD || IS_DEBUG);

// ============================================================================
// INITIAL DATA PREPARATION
// ============================================================================

// Properties sent with first $pageview event
// Includes environment field for easy filtering
const initialProperties = {
  environment: isTestingMode ? 'testing' : 'production',
  pageCategory,
  pageType,
  ...additionalData,
};
---

<!-- ============================================================================
     TEMPLATE: SCRIPT INJECTION
     ============================================================================ -->

{!POSTHOG_KEY && (
  <script is:inline>
    console.warn('[PostHog] No PostHog key configured. Set PUBLIC_POSTHOG_KEY in .env, or use AnalyticsSetup with PUBLIC_LIVE_TESTING and PUBLIC_POSTHOG_TESTING_ID for testing mode.');
  </script>
)}

{shouldLoadPostHog && (
  <>
    <!-- ===================================================================
         PostHog Loader Snippet + Initialization
         =================================================================== -->
    <!--
      Official PostHog snippet (minified)
      Creates stub functions that queue calls until SDK loads
    -->
    <script is:inline define:vars={{ POSTHOG_KEY, initialProperties, isTestingMode }}>
      // ============================================================================
      // POSTHOG LOADER SNIPPET (Official)
      // ============================================================================
      
      // Minified loader that:
      // 1. Creates stub window.posthog object with queue
      // 2. Defines all PostHog methods as stubs
      // 3. Downloads SDK asynchronously from PostHog CDN
      // 4. Replaces stubs with real implementation when SDK loads
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);

      // ============================================================================
      // POSTHOG CONFIGURATION
      // ============================================================================
      
      posthog.init(POSTHOG_KEY, {
        // API endpoint (us.i.posthog.com for US region)
        api_host: 'https://us.i.posthog.com',
        
        // ============================================================================
        // PRIVACY-FIRST: Only track identified users
        // ============================================================================
        
        // person_profiles: 'identified_only'
        // - Anonymous visitors: NOT tracked (GDPR/privacy friendly)
        // - After identifyUser(): Start tracking and enable session replay
        // - This is the recommended setting for privacy compliance
        person_profiles: 'identified_only',
        
        // ============================================================================
        // AUTO-CAPTURE EVENTS
        // ============================================================================
        
        // PostHog can automatically capture:
        // - Page views ($pageview)
        // - Page exits ($pageleave)
        // - Clicks, form submissions, etc (autocapture)
        autocapture: true,
        capture_pageview: true,
        capture_pageleave: true,
        
        // ============================================================================
        // SESSION REPLAY (Only for identified users)
        // ============================================================================
        
        session_recording: {
          // maskAllInputs: true
          // - Replaces all <input> content with asterisks (*)
          // - Prevents recording of passwords, emails, credit cards
          maskAllInputs: true,
          
          // maskTextSelector: '[data-private]'
          // - Any element with data-private attribute gets masked
          // - Use on sensitive UI elements (balances, names, etc)
          maskTextSelector: '[data-private]',
        },
        
        // ============================================================================
        // PERFORMANCE
        // ============================================================================
        
        // Keep session recording enabled (requires identifyUser())
        disable_session_recording: false,
        
        // Don't record console.log (reduces noise in replays)
        enable_recording_console_log: false,
      });

      // ============================================================================
      // REGISTER SUPER PROPERTIES
      // ============================================================================
      
      // Super properties are automatically included in ALL PostHog events
      // This ensures the environment field is present on every event
      posthog.register({
        environment: initialProperties.environment
      });
      
      // ============================================================================
      // INITIAL PAGEVIEW
      // ============================================================================
      
      // Capture first pageview with page metadata
      // Apply [TEST] prefix if in testing mode
      // Only fires if initialProperties has data
      if (Object.keys(initialProperties).length > 0) {
        const pageviewEventName = isTestingMode ? '[TEST] $pageview' : '$pageview';
        posthog.capture(pageviewEventName, initialProperties);
      }

      // ============================================================================
      // INITIALIZATION FLAG
      // ============================================================================
      
      // Mark as initialized (used by isAnalyticsReady() util)
      window.posthogInitialized = true;
    </script>
  </>
)}

{IS_DEBUG && shouldLoadPostHog && (
  <script is:inline>
    console.log('[PostHog] Initialized');
  </script>
)}
