---
import { Image } from "astro:assets";

import logoScalify from "../../assets/images/logo-scalify-bn.webp";
import CustomClickEvent from "@/components/analytics/headless/CustomClickEvent.astro";

const columns = [
  {
    title: "Agencia",
    links: [{ name: "Servicios", href: "#services" }],
  },
  {
    title: "Compañía",
    links: [
      { name: "Acerca de nosotros", href: "#about-us" },
      { name: "Contacto", href: "mailto:consultas@scalifyagencia.online" },
    ],
  },
  {
    title: "Legal",
    links: [
      { name: "Política de privacidad", href: "/política-de-privacidad" },
      { name: "Términos y condiciones", href: "/términos-y-condiciones" },
    ],
  },
];

const socials = [
  { name: "LinkedIn", href: "https://linkedin.com", icon: "linkedin" },
  { name: "Twitter", href: "https://twitter.com", icon: "twitter" },
  { name: "Facebook", href: "https://facebook.com", icon: "facebook" },
];
---

<footer class="bg-primary text-primary-foreground px-2.5 lg:px-0">
  <div class="container py-12 md:py-16">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="md:min-w-[140px]">
        <a href="/" aria-label="Scalify">
          <Image src={logoScalify} alt="Scalify" width={140} height={32} loading="lazy" decoding="async" />
        </a>
      </div>

      <div class="grid grid-cols-2 gap-10 sm:grid-cols-3 md:flex md:items-start md:justify-between md:gap-10">
        {
          columns.map((col) => (
            <div class="min-w-0">
              <h3 class="text-muted-foreground mb-4 text-sm font-medium leading-tight">{col.title}</h3>
              <ul class="space-y-3">
                {col.links.map((link) => (
                  <li>
                    <CustomClickEvent 
                      eventName="footer_link_click"
                      location="footer"
                      linkText={link.name}
                      linkSection={col.title}
                    >
                      <a href={link.href} class="text-primary-foreground/90 hover:text-primary-foreground text-sm font-normal transition-colors">
                        {link.name}
                      </a>
                    </CustomClickEvent>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="border-border/40 mt-12 border-t"></div>

    <div class="mt-6 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
      <p class="text-muted-foreground text-sm font-normal">
        © {new Date().getFullYear()} Scalify. All rights reserved
      </p>

      <div class="flex items-center gap-4">
        {
          socials.map((social) => (
            <CustomClickEvent 
              eventName="social_click"
              location="footer"
              socialNetwork={social.name}
            >
              <a
                href={social.href}
                aria-label={social.name}
                class="text-muted-foreground hover:text-primary-foreground transition-colors"
              >
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                {social.icon === "linkedin" && (
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                )}
                {social.icon === "twitter" && (
                  <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z" />
                )}
                {social.icon === "facebook" && (
                  <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z" />
                )}
              </svg>
              </a>
            </CustomClickEvent>
          ))
        }
      </div>
    </div>
  </div>
</footer>
