# Site URL for metadata and canonical URLs
# This will be used for Open Graph images, canonical URLs, sitemap, etc.
# For production, set this to your custom domain
SITE_URL=https://scalify-landing.vercel.app


# Google Tag Manager ID (obtener desde GTM admin)
PUBLIC_GTM_ID=GTM-XXXXXXX

# PostHog Project API Key (opcional, obtener desde PostHog settings)
PUBLIC_POSTHOG_KEY=phc_XXXXXXX

# Habilitar modo debug (muestra logs en consola incluso en producción)
PUBLIC_ANALYTICS_DEBUG=true

# Habilitar Live testing con testing IDs (opcional, solo si PUBLIC_LIVE_TESTING=true)
PUBLIC_LIVE_TESTING=true

PUBLIC_GTM_TESTING_ID=GTM-XXXXXXX
PUBLIC_POSTHOG_TESTING_ID=phc_XXXXXXX